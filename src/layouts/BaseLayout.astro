---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../config/site';
import { UI } from '../data/ui';
import { CALENDLY, url } from '../data/routes';

interface Breadcrumb {
  name: string;
  url: string;
}

interface Props {
  title: string;
  description: string;
  keywords?: string;
  path: string;
  lang?: Locale;
  ogType?: string;
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  breadcrumbs?: Breadcrumb[];
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  /** Section in the header to mark as current */
  current?: 'products' | 'services' | 'industry' | 'about' | 'contact';
  /** Where the sticky "Contattaci" (mobile) points to; defaults to the contact page */
  contactHref?: string;
}

const {
  title,
  description,
  keywords,
  path,
  lang = 'it',
  ogType,
  ogImage,
  ogImageAlt,
  noindex = false,
  breadcrumbs,
  structuredData,
  current,
  contactHref,
} = Astro.props;

const t = UI[lang];
const contact = contactHref ?? url(lang, 'contact');
---

<!doctype html>
<html lang={lang}>
  <head>
    <SEO
      title={title}
      description={description}
      keywords={keywords}
      path={path}
      lang={lang}
      ogType={ogType}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      noindex={noindex}
      breadcrumbs={breadcrumbs}
      structuredData={structuredData}
    />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <Header lang={lang} path={path} current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <div class="sticky">
      <a class="btn btn-g" href={CALENDLY}>{t.bookCall}</a>
      <a class="btn btn-p" href={contact}>{t.contactUs}</a>
    </div>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
