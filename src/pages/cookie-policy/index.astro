---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Content from '../../components/content/it-cookie-policy.astro';
const structuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "Cookie Policy",
  "description": "Informativa sui cookie di Pamasoft",
  "url": "https://pamasoft.com/cookie-policy/"
};
---

<BaseLayout
  title={`Informativa Cookie - Pamasoft`}
  description={`Informativa sui cookie utilizzati dal sito Pamasoft. Scopri quali cookie utilizziamo, come gestirli e come proteggere la tua privacy durante la navigazione.`}
  path="/cookie-policy/"
  lang="it"
  keywords={`cookie policy, cookie, gdpr, google analytics, privacy, pamasoft`}
  breadcrumbs={[{"name":"Cookie Policy","url":"/cookie-policy/"}]}
  ogImage="https://images.unsplash.com/photo-1450101499163-c8848c66ca85?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80"
  structuredData={structuredData}
>
  <Content />
</BaseLayout>
