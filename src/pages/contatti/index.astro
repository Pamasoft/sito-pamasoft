---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Content from '../../components/content/it-contatti.astro';
const structuredData = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "mainEntity": {
    "@type": "Organization",
    "name": "Pamasoft",
    "url": "https://pamasoft.com",
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "sales",
      "email": "info@pamasoft.com",
      "areaServed": "IT",
      "availableLanguage": [
        "Italian",
        "English"
      ],
      "hoursAvailable": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": [
          "Monday",
          "Tuesday",
          "Wednesday",
          "Thursday",
          "Friday"
        ],
        "opens": "09:00",
        "closes": "18:00"
      }
    },
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Via E. Fermi, 75",
      "addressLocality": "Pistoia",
      "postalCode": "51100",
      "addressRegion": "PT",
      "addressCountry": "IT"
    }
  }
};
---

<BaseLayout
  title={`Contatti Pamasoft | Consulenza IT Cloud AWS, AI, Blockchain`}
  description={`Contatta Pamasoft per consulenza IT: Cloud AWS, Intelligenza Artificiale, Blockchain, Cybersecurity. Sede a Pistoia, preventivi e supporto dedicato.`}
  path="/contatti/"
  lang="it"
  keywords={`contatti Pamasoft, consulenza IT cloud AWS, preventivi software, supporto tecnico, consulenza AI blockchain, azienda IT Pistoia Toscana`}
  pageClass="contact-page"
  ogImage="https://images.unsplash.com/photo-1423666639041-f56000c27a9a?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80"
  breadcrumbs={[{"name":"Contatti","url":"/contatti/"}]}
  structuredData={structuredData}
>
  <Content />
</BaseLayout>
