---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductsGrid from '../../components/ProductsGrid.astro';
import { site } from '../../config/site';
import { absoluteAssetUrl } from '../../lib/product-seo';

const prodotti = (await getCollection('prodotti', ({ data }) => data.lingua === 'it' && data.pubblicato)).sort(
  (a, b) => a.data.nome.localeCompare(b.data.nome, 'it'),
);

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Prodotti SaaS Pamasoft',
  description: 'Catalogo prodotti software cloud Pamasoft',
  numberOfItems: prodotti.length,
  itemListElement: prodotti.map((p, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: p.data.nome,
    url: `${site.url}/prodotti/${p.data.slug}/`,
    image: absoluteAssetUrl(p.data.logo.src),
  })),
};
---

<BaseLayout
  title="Prodotti SaaS Pamasoft | Soluzioni Software Cloud"
  description="Scopri i prodotti SaaS di Pamasoft: CloudStay, CloudSuite, CloudPos, Healthcare, Posway, SPOORTAL, Playten e Virtual Clinic."
  keywords="prodotti Pamasoft, SaaS, CloudStay, CloudSuite, CloudPos, Healthcare, Posway, SPOORTAL, Playten, Virtual Clinic"
  path="/prodotti/"
  lang="it"
  pageClass="prodotti-page"
  breadcrumbs={[{ name: 'Prodotti', url: '/prodotti/' }]}
  ogImage="https://images.unsplash.com/photo-1460925895917-afdab827c52f?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80"
  ogImageAlt="Prodotti SaaS Pamasoft"
  structuredData={itemListSchema}
>
  <section class="hero-empowerment-area">
    <div class="custom-container">
      <div class="custom-row align-items-center">
        <div class="hero-empowerment-left-content">
          <h5 class="section-subtitle">PRODOTTI</h5>
          <h1 class="section-title">Le soluzioni SaaS di Pamasoft</h1>
          <p>
            Piattaforme verticali, strumenti operativi e brand autonomi con dominio dedicato: l'ecosistema software
            Pamasoft per aziende, strutture sanitarie, retail, hospitality e molto altro.
          </p>
        </div>
        <div class="hero-empowerment-right-content">
          <div class="top-content">
            <img
              class="desktop fade-in"
              src="https://images.unsplash.com/photo-1551434678-e076c223a692?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80"
              alt="Prodotti software Pamasoft"
              width="800"
              height="600"
              fetchpriority="high"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="products-section">
    <div class="custom-container">
      <div class="products-section-header">
        <h2 class="section-title">Tutti i prodotti</h2>
        <p>Ogni prodotto ha una scheda dedicata su pamasoft.com e, dove previsto, un sito o applicazione autonoma.</p>
      </div>
      <ProductsGrid prodotti={prodotti} lang="it" />
    </div>
  </section>
</BaseLayout>
