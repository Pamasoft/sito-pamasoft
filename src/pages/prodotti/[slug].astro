---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductDetail from '../../components/ProductDetail.astro';
import {
  absoluteAssetUrl,
  buildProductStructuredData,
  metaDescriptionFromProduct,
  productKeywords,
  productOgImage,
  productPageTitle,
} from '../../lib/product-seo';

export async function getStaticPaths() {
  const prodotti = await getCollection('prodotti', ({ data }) => data.lingua === 'it' && data.pubblicato);
  return prodotti.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;

const pageUrl = `https://pamasoft.com/prodotti/${data.slug}/`;
const description = metaDescriptionFromProduct(data);
const ogImage = productOgImage(data);
const structuredData = buildProductStructuredData({
  data,
  lang: 'it',
  pageUrl,
  metaDescription: description,
});
---

<BaseLayout
  title={productPageTitle(data, 'it')}
  description={description}
  keywords={productKeywords(data, 'it')}
  path={`/prodotti/${data.slug}/`}
  lang="it"
  pageClass="prodotto-page"
  ogImage={ogImage}
  ogImageAlt={`${data.nome} — ${data.tagline}`}
  breadcrumbs={[
    { name: 'Prodotti', url: '/prodotti/' },
    { name: data.nome, url: `/prodotti/${data.slug}/` },
  ]}
  structuredData={structuredData}
>
  <ProductDetail data={data} lang="it">
    <Content />
  </ProductDetail>
</BaseLayout>
