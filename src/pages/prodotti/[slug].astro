---
import ProductView from '../../views/ProductView.astro';
import CloudStayView from '../../views/CloudStayView.astro';
import CloudPosHubView from '../../views/CloudPosHubView.astro';
import { PRODUCTS, type Product } from '../../data/products';

export function getStaticPaths() {
  return PRODUCTS.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Product };
---

{p.id === 'cloudstay' ? <CloudStayView lang="it" /> : p.id === 'cloudpos' ? <CloudPosHubView lang="it" /> : <ProductView lang="it" p={p} />}
