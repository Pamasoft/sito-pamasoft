---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Content from '../../../components/content/en-about.astro';
const structuredData = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "mainEntity": {
    "@type": "Organization",
    "name": "Pamasoft",
    "foundingDate": "1999",
    "numberOfEmployees": {
      "@type": "QuantitativeValue",
      "value": "50"
    },
    "description": "Italian IT company with over 25 years of experience in AWS cloud computing, artificial intelligence, blockchain and cybersecurity",
    "knowsAbout": [
      "AWS Cloud Computing",
      "Artificial Intelligence",
      "Blockchain",
      "Cybersecurity",
      "Microservices",
      "DevOps"
    ],
    "slogan": "Technological Innovation since 1999"
  }
};
---

<BaseLayout
  title={`About Pamasoft | 25+ Years IT Experience & Digital Transformation`}
  description={`Pamasoft: 25+ years IT experience, 500+ completed projects, expert team in AWS cloud, AI, blockchain. History, values and expertise of our Italian technology company.`}
  path="/en/about/"
  lang="en"
  keywords={`Pamasoft IT company Italy, 25 years software experience, expert developer team, technology company history, innovation values, IT consulting Milan, digital transformation`}
  pageClass="about-page"
  ogImage="https://images.unsplash.com/photo-1522071820081-009f0129c71c?ixlib=rb-4.0.3&auto=format&fit=crop&w=1200&q=80"
  breadcrumbs={[{"name":"About","url":"/en/about/"}]}
  structuredData={structuredData}
>
  <Content />
</BaseLayout>
