---
---
<!-- Hero Section -->
<section class="hero-empowerment-area">
    <div class="custom-container">
        <div class="custom-row align-items-center">
            <div class="hero-empowerment-left-content">
                <h5 class="section-subtitle">OUR SERVICES</h5>
                <h1 class="section-title fade-in">Complete IT Solutions for Your Business</h1>
                <p>From digital transformation to cybersecurity, we offer specialized IT services to grow your business with cutting-edge technologies.</p>
                <div class="btns-group d-flex">
                    <a href="/en/contact/" class="theme-btn">Request Consultation</a>
                    <a href="/en/about/" class="theme-btn2">About Us
                        <i class="fas fa-arrow-up"></i>
                    </a>
                </div>
            </div>

            <div class="hero-empowerment-right-content">
                <div class="top-content">
                    <img class="desktop fade-in" src="https://images.unsplash.com/photo-1460925895917-afdab827c52f?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Pamasoft IT Services" width="800" height="600" fetchpriority="high" />

                    <div class="experience-box simple-shadow bounce-in">
                        <div class="experience-body d-flex align-items-center">
                            <img src="/assets/imgs/icon-years.svg" alt="Services Icon" />
                            <div class="experience-content d-flex align-items-center">
                                <h1>5</h1>
                                <p>
                                    Specialized
                                    <span>Services</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Services Overview -->
<section class="service-area">
    <div class="custom-container">
        <div class="service-section-header section-header d-flex align-items-end justify-content-between">
            <div class="left">
                <h5 class="section-subtitle">SPECIALIZED SERVICES</h5>
                <h1 class="section-title">Our Technological Expertise</h1>
            </div>
            <p>With over 25 years of experience, we offer complete solutions for every business IT need.</p>
        </div>

        <div class="services-list d-flex">
            <div class="service-card simple-shadow">
                <i class="fas fa-cloud fa-3x service-icon"></i>
                <h3><a href="/en/services/cloud-computing/">Cloud Computing</a></h3>
                <p>Cloud migration, scalable infrastructures and DevOps automation to optimize costs and performance.</p>
                <div style="margin-top: auto;">
                    <a href="/en/services/cloud-computing/" class="theme-btn" style="width: 100%; text-align: center; margin-top: 1rem;">Learn more</a>
                </div>
            </div>
            
            <div class="service-card simple-shadow">
                <i class="fas fa-brain fa-3x service-icon"></i>
                <h3><a href="/en/services/artificial-intelligence/">Artificial Intelligence</a></h3>
                <p>Machine Learning, generative AI, chatbots and intelligent automation to transform your business processes.</p>
                <div style="margin-top: auto;">
                    <a href="/en/services/artificial-intelligence/" class="theme-btn" style="width: 100%; text-align: center; margin-top: 1rem;">Learn more</a>
                </div>
            </div>
            
            <div class="service-card simple-shadow">
                <i class="fas fa-link fa-3x service-icon"></i>
                <h3><a href="/en/services/blockchain/">Blockchain & Web3</a></h3>
                <p>Smart contracts, DeFi, NFT and blockchain solutions for security, transparency and decentralization.</p>
                <div style="margin-top: auto;">
                    <a href="/en/services/blockchain/" class="theme-btn" style="width: 100%; text-align: center; margin-top: 1rem;">Learn more</a>
                </div>
            </div>
            
            <div class="service-card simple-shadow">
                <i class="fas fa-shield-alt fa-3x service-icon"></i>
                <h3><a href="/en/services/cybersecurity/">Cybersecurity</a></h3>
                <p>Complete protection, penetration testing, GDPR compliance and 24/7 monitoring for total security.</p>
                <div style="margin-top: auto;">
                    <a href="/en/services/cybersecurity/" class="theme-btn" style="width: 100%; text-align: center; margin-top: 1rem;">Learn more</a>
                </div>
            </div>
            
            <div class="service-card simple-shadow">
                <i class="fas fa-code fa-3x service-icon"></i>
                <h3><a href="/en/services/web-application-development/">Web Application Development</a></h3>
                <p>Modern web applications with Spring Boot, React, PostgreSQL and cutting-edge technology stacks.</p>
                <div style="margin-top: auto;">
                    <a href="/en/services/web-application-development/" class="theme-btn" style="width: 100%; text-align: center; margin-top: 1rem;">Learn more</a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Why Choose Us -->
<section class="about-area">
    <div class="custom-container">
        <div class="custom-row justify-content-between align-items-center">
            <div class="left-content">
                <h5 class="section-subtitle">WHY CHOOSE PAMASOFT</h5>
                <h1 class="section-title">25+ Years of IT Excellence</h1>
                <p>Our proven experience and passion for innovation make us the ideal partner for your digital transformation.</p>
                <ul>
                    <li>
                        <i class="icon-check las la-check"></i> Over 500 projects successfully completed
                    </li>
                    <li>
                        <i class="icon-check las la-check"></i> Team of certified and specialized experts
                    </li>
                    <li>
                        <i class="icon-check las la-check"></i> Ongoing support and long-term partnerships
                    </li>
                    <li>
                        <i class="icon-check las la-check"></i> Agile methodologies and international best practices
                    </li>
                </ul>
                <a href="/en/about/" class="theme-btn">Our Story</a>
            </div>
            <div class="right-content">
                <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Pamasoft Team" class="img-fluid rounded shadow" width="600" height="400" loading="lazy" decoding="async">
            </div>
        </div>
    </div>
</section>

<!-- Technologies -->
<section class="how-we-do-area">
    <div class="custom-container">
        <div class="section-header text-center">
            <h5 class="section-subtitle">TECHNOLOGIES</h5>
            <h1 class="section-title">Cutting-Edge Technology Stacks</h1>
        </div>
        
        <div class="how-we-do-body">
            <div class="custom-row">
                <div class="how-we-do-card">
                    <div class="how-we-do-card-inner">
                        <div class="icon">
                            <i class="fab fa-aws"></i>
                        </div>
                        <h3>Cloud & Infrastructure</h3>
                        <p>AWS, Azure, Google Cloud, Docker, Kubernetes for modern and scalable infrastructures.</p>
                    </div>
                </div>
                
                <div class="how-we-do-card">
                    <div class="how-we-do-card-inner">
                        <div class="icon">
                            <i class="fas fa-brain"></i>
                        </div>
                        <h3>AI & Machine Learning</h3>
                        <p>TensorFlow, PyTorch, OpenAI, scikit-learn for advanced artificial intelligence solutions.</p>
                    </div>
                </div>
                
                <div class="how-we-do-card">
                    <div class="how-we-do-card-inner">
                        <div class="icon">
                            <i class="fab fa-java"></i>
                        </div>
                        <h3>Development</h3>
                        <p>Java Spring Boot, React, Node.js, PostgreSQL for robust and high-performance web applications.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Contact Section -->
<section class="contact-area">
    <div class="custom-container">
        <div class="custom-row">
            <div class="contact-experience">
                <ul>
                    <li>
                        <h1>25+ <span>Years</span></h1>
                        <p>IT Industry Experience</p>
                    </li>
                    <li>
                        <h1>500+ <span>Projects</span></h1>
                        <p>Successfully Completed</p>
                    </li>
                    <li>
                        <h1>Full <span>Stack</span></h1>
                        <p>Delivery</p>
                    </li>
                    <li>
                        <h1>5 <span>Services</span></h1>
                        <p>Technological Specializations</p>
                    </li>
                </ul>
            </div>
            
            <div class="contact-form-wrap">
                <div class="contact-form-body">
                    <h5 class="section-subtitle">START TODAY</h5>
                    <h1 class="section-title">Ready to Transform Your Business?</h1>
                    <p>Contact us for a free consultation and discover how our IT services can accelerate your company's growth.</p>
                    <div class="btns-group d-flex">
                        <a href="/en/contact/" class="theme-btn">Free Consultation</a>
                        <a href="/en/about/" class="theme-btn2">About Us
                            <i class="fas fa-arrow-up"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
