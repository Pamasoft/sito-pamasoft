---
---
<!-- Hero Section -->
<section class="hero-empowerment-area">
    <div class="custom-container">
        <div class="custom-row align-items-center">
            <div class="hero-empowerment-left-content">
                <h5 class="section-subtitle">CONTACT US</h5>
                <h1 class="section-title fade-in">Let's Talk</h1>
                <p>Have a project in mind? Want a free consultation? Our team of experts is ready to help you transform your ideas into innovative technological solutions.</p>
                <div class="btns-group d-flex">
                    <a href="#contact-form" class="theme-btn">Send Message</a>
                    <a href="https://calendly.com/pamasoft/30min" target="_blank" rel="noopener noreferrer" class="theme-btn2">Book a call
                        <i class="fas fa-arrow-up"></i>
                    </a>
                </div>
            </div>

            <div class="hero-empowerment-right-content">
                <div class="top-content">
                    <img class="desktop fade-in" src="https://images.unsplash.com/photo-1556761175-b413da4baf72?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Contact Pamasoft" width="800" height="600" fetchpriority="high" />

                    <div class="experience-box simple-shadow bounce-in">
                        <div class="experience-body d-flex align-items-center">
                            <img src="/assets/imgs/icon-years.svg" alt="Support Icon" />
                            <div class="experience-content d-flex align-items-center">
                                <h1>Team</h1>
                                <p>
                                    Dedicated
                                    <span>Available</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Contact Information -->
<section class="about-area">
    <div class="custom-container">
        <div class="custom-row justify-content-between align-items-center">
            <div class="left-content">
                <h5 class="section-subtitle">CONTACT INFORMATION</h5>
                <h1 class="section-title">How to Reach Us</h1>
                <p>We are always available to answer your questions and discuss your technological needs.</p>
                <ul>
                    <li>
                        <i class="icon-check las la-calendar"></i> <a href="https://calendly.com/pamasoft/30min" target="_blank" rel="noopener noreferrer">Book a call</a>
                    </li>
                    <li>
                        <i class="icon-check las la-envelope"></i> info@pamasoft.com
                    </li>
                    <li>
                        <i class="icon-check las la-map-marker"></i> Via E. Fermi, 75 - 51100 Pistoia, Italy
                    </li>
                    <li>
                        <i class="icon-check las la-clock"></i> Mon-Fri: 9:00-18:00
                    </li>
                </ul>
                <a href="mailto:info@pamasoft.com" class="theme-btn">Send Email</a>
            </div>
            <div class="right-content">
                <img src="https://images.unsplash.com/photo-1553877522-43269d4ea984?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Pamasoft Office Milan" class="img-fluid rounded shadow" width="600" height="400" loading="lazy" decoding="async">
            </div>
        </div>
    </div>
</section>

<!-- Contact Form -->
<section class="contact-area" id="contact-form">
    <div class="custom-container">
        <div class="custom-row">
            <div class="contact-form-wrap">
                <div class="contact-form-body">
                    <h5 class="section-subtitle">SEND MESSAGE</h5>
                    <h1 class="section-title">Request a Free Consultation</h1>
                    <p>Fill out the form to receive a personalized consultation within 24 hours. All fields marked with * are required.</p>
                    
                    <form id="contact-form-page" class="contact-form" method="POST" action="https://erp.pamasoft.com/send-email.jsp">
                        <!-- Honeypot field -->
                        <input type="text" name="website" id="website_page" style="position: absolute; left: -5000px;" tabindex="-1" autocomplete="off" />
                        <!-- Timestamp field -->
                        <input type="hidden" name="form_timestamp" id="form_timestamp_page" />
                        
                        <div class="input-row">
                            <div class="input-group">
                                <label for="first_name">First Name *</label>
                                <input id="first_name" type="text" name="first_name" placeholder="Your first name" required />
                            </div>
                            <div class="input-group">
                                <label for="last_name">Last Name *</label>
                                <input id="last_name" type="text" name="last_name" placeholder="Your last name" required />
                            </div>
                        </div>
                        
                        <div class="input-row">
                            <div class="input-group">
                                <label for="email">Email *</label>
                                <input type="email" id="email" name="email" placeholder="Your email" required />
                            </div>
                            <div class="input-group">
                                <label for="company">Company</label>
                                <input type="text" id="company" name="company" placeholder="Company name" />
                            </div>
                        </div>
                        
                        <div class="input-row">
                            <div class="input-group">
                                <label for="phone_number">Phone</label>
                                <div class="phone-input-wrapper">
                                    <select name="phone_prefix" class="phone-prefix" id="phone_prefix">
                                        <option value="+39">🇮🇹 IT (+39)</option>
                                        <option value="+1" selected>🇺🇸 US (+1)</option>
                                        <option value="+1">🇨🇦 CA (+1)</option>
                                        <option value="+44">🇬🇧 UK (+44)</option>
                                        <option value="+33">🇫🇷 FR (+33)</option>
                                        <option value="+49">🇩🇪 DE (+49)</option>
                                        <option value="+34">🇪🇸 ES (+34)</option>
                                        <option value="+351">🇵🇹 PT (+351)</option>
                                        <option value="+41">🇨🇭 CH (+41)</option>
                                        <option value="+43">🇦🇹 AT (+43)</option>
                                        <option value="+32">🇧🇪 BE (+32)</option>
                                        <option value="+31">🇳🇱 NL (+31)</option>
                                        <option value="+46">🇸🇪 SE (+46)</option>
                                        <option value="+47">🇳🇴 NO (+47)</option>
                                        <option value="+45">🇩🇰 DK (+45)</option>
                                        <option value="+358">🇫🇮 FI (+358)</option>
                                        <option value="+48">🇵🇱 PL (+48)</option>
                                        <option value="+420">🇨🇿 CZ (+420)</option>
                                        <option value="+86">🇨🇳 CN (+86)</option>
                                        <option value="+81">🇯🇵 JP (+81)</option>
                                        <option value="+82">🇰🇷 KR (+82)</option>
                                        <option value="+91">🇮🇳 IN (+91)</option>
                                        <option value="+61">🇦🇺 AU (+61)</option>
                                        <option value="+64">🇳🇿 NZ (+64)</option>
                                        <option value="+55">🇧🇷 BR (+55)</option>
                                        <option value="+52">🇲🇽 MX (+52)</option>
                                        <option value="+54">🇦🇷 AR (+54)</option>
                                    </select>
                                    <input id="phone_number" type="tel" name="phone_number" placeholder="Phone number" />
                                </div>
                            </div>
                            <div class="input-group">
                                <label for="service">Service of Interest</label>
                                <select id="service" name="service">
                                    <option value="">Select a service</option>
                                    <option value="cloud-computing">Cloud Computing</option>
                                    <option value="artificial-intelligence">Artificial Intelligence</option>
                                    <option value="blockchain">Blockchain & Web3</option>
                                    <option value="cybersecurity">Cybersecurity</option>
                                    <option value="web-development">Web Application Development</option>
                                    <option value="general-consulting">General Consulting</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="input-row">
                            <div class="input-group">
                                <label for="message">Message *</label>
                                <textarea name="message" id="message" placeholder="Describe your project or needs..." rows="5" required></textarea>
                            </div>
                        </div>
                        
                        <div class="input-row">
                            <div class="input-group input-checkbox">
                                <input type="checkbox" id="privacy_policy_accept" name="privacy_accept" required>
                                <label for="privacy_policy_accept">I accept the <a href="/en/privacy-policy/" target="_blank">Privacy Policy</a> and <a href="/en/terms-of-service/" target="_blank">Terms of Service</a> *</label>
                            </div>
                        </div>
                        
                        <div class="input-row">
                            <div class="input-group input-checkbox">
                                <input type="checkbox" id="newsletter_accept" name="newsletter_accept">
                                <label for="newsletter_accept">I would like to receive updates and newsletter (optional)</label>
                            </div>
                        </div>

                        <div class="input-row">
                            <div class="input-group">
                                <button type="submit" class="theme-btn">
                                    <span class="btn-text">Send Request</span>
                                    <span id="loading-page" class="htmx-indicator spinner-border spinner-border-sm" style="display: none; margin-left: 10px;"></span>
                                </button>
                            </div>
                        </div>
                        
                        <!-- Alert Message -->
                        <div class="input-row">
                            <div class="input-group">
                                <div id="form-response-page" class="alert-notification"></div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="contact-infos">
                <div class="contact-infos-inner">
                    <div class="contact-info">
                        <img src="/assets/imgs/support-icon.svg" alt="Support" />
                        <h3>Contact Information</h3>
                        <p>
                            <a href="https://calendly.com/pamasoft/30min" target="_blank" rel="noopener noreferrer">Book a call</a> <br>
                            Email: info@pamasoft.com
                        </p>
                    </div>
                    <div class="contact-office-info contact-info">
                        <img src="/assets/imgs/map-icon.svg" alt="Map" />
                        <h3>Headquarters</h3>
                        <p>Via E. Fermi, 75<br>
                            51100 Pistoia, Italy</p>
                    </div>

                    <ul class="contact-social-links">
                        <li>
                            <a href="https://x.com/pamasoft" target="_blank" rel="noopener noreferrer">
                                <i class="fab fa-x-twitter"></i>
                                X (Twitter)
                            </a>
                        </li>
                        <li>
                            <a href="https://www.linkedin.com/company/pamasoft" target="_blank" rel="noopener noreferrer">
                                <i class="fab fa-linkedin-in"></i>
                                LinkedIn
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Contact Details -->
<section class="how-we-do-area">
    <div class="custom-container">
        <div class="section-header text-center">
            <h5 class="section-subtitle">HOW WE CAN HELP YOU</h5>
            <h1 class="section-title">Our Consulting Services</h1>
        </div>
        
        <div class="how-we-do-body">
            <div class="custom-row">
                <div class="how-we-do-card">
                    <div class="how-we-do-card-inner">
                        <div class="icon">
                            <i class="fas fa-phone"></i>
                        </div>
                        <h3>Phone Consultation</h3>
                        <p>Call us for immediate and free consultation on our services and solutions.</p>
                    </div>
                </div>
                
                <div class="how-we-do-card">
                    <div class="how-we-do-card-inner">
                        <div class="icon">
                            <i class="fas fa-calendar"></i>
                        </div>
                        <h3>Scheduled Meeting</h3>
                        <p>Book a meeting to discuss your project in detail with our experts.</p>
                    </div>
                </div>
                
                <div class="how-we-do-card">
                    <div class="how-we-do-card-inner">
                        <div class="icon">
                            <i class="fas fa-headset"></i>
                        </div>
                        <h3>Ongoing Support</h3>
                        <p>24/7 technical assistance for all clients with active support contracts.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
