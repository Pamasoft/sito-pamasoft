---
import IndustryRelatedProducts from '../IndustryRelatedProducts.astro';
---
<!-- Hero Section -->
<section class="hero-empowerment-area">
    <div class="custom-container">
        <div class="custom-row align-items-center">
            <div class="hero-empowerment-left-content">
                <h5 class="section-subtitle">RETAIL</h5>
                <h1 class="section-title fade-in">IT Solutions for <br><span>Modern Retail</span></h1>
                <p>We transform the retail sector with innovative technologies: e-commerce platforms, omnichannel strategies, intelligent inventory management and data analytics to increase sales and loyalty.</p>
                <div class="btns-group d-flex">
                    <a href="/en/contact/" class="theme-btn">Request Consultation</a>
                    <a href="/en/industry/" class="theme-btn2">Other Industries
                        <i class="fas fa-arrow-up"></i>
                    </a>
                </div>
            </div>

            <div class="hero-empowerment-right-content">
                <div class="top-content">
                    <img class="desktop fade-in" src="https://images.unsplash.com/photo-1556740738-b6a63e27c4df?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Retail IT Solutions" width="800" height="600" fetchpriority="high" />

                    <div class="experience-box simple-shadow bounce-in">
                        <div class="experience-body d-flex align-items-center">
                            <img src="/assets/imgs/icon-years.svg" alt="Retail" />
                            <div class="experience-content d-flex align-items-center">
                                <h1>50+</h1>
                                <p>
                                    Retail
                                    <span>Projects</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Overview Section -->
<section class="about-area">
    <div class="custom-container">
        <div class="custom-row justify-content-between align-items-center">
            <div class="left-content">
                <h5 class="section-subtitle">DIGITAL TRANSFORMATION</h5>
                <h1 class="section-title">Innovation for Commerce</h1>
                <p>Our IT solutions help retailers create integrated shopping experiences between online and offline, optimize inventory management and use data to personalize offerings.</p>
                <ul>
                    <li><i class="icon-check las la-check"></i> <strong>E-commerce Platforms:</strong> High-performance solutions for selling online</li>
                    <li><i class="icon-check las la-check"></i> <strong>Omnichannel:</strong> Unified customer experience across all channels</li>
                    <li><i class="icon-check las la-check"></i> <strong>Inventory Management:</strong> Intelligent stock management</li>
                    <li><i class="icon-check las la-check"></i> <strong>CRM & Analytics:</strong> Know and retain customers</li>
                    <li><i class="icon-check las la-check"></i> <strong>Cloud POS Systems:</strong> Flexibility and control for point of sale</li>
                </ul>
                <a href="/en/contact/" class="theme-btn">Discover Solutions</a>
            </div>
            <div class="right-content">
                <img src="https://images.unsplash.com/photo-1522204523234-8729aa6e3d5f?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Digital Retail" class="img-fluid rounded shadow" width="600" height="400" loading="lazy" decoding="async">
            </div>
        </div>
    </div>
</section>

<!-- Solutions -->
<section class="service-area">
    <div class="custom-container">
        <div class="service-section-header section-header d-flex align-items-end justify-content-between">
            <div class="left">
                <h5 class="section-subtitle">SOLUTIONS</h5>
                <h1 class="section-title">Our Retail Solutions</h1>
            </div>
            <p>Cutting-edge technologies to modernize commerce</p>
        </div>
        
        <div class="services-list">
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-1.svg" alt="E-commerce">
                </div>
                <h3>E-commerce Platforms</h3>
                <p>We develop high-performance, scalable B2C and B2B e-commerce sites integrated with business systems.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-2.svg" alt="Omnichannel">
                </div>
                <h3>Omnichannel Strategies</h3>
                <p>We create unified customer experiences between physical store, e-commerce, mobile and social media.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-3.svg" alt="CRM">
                </div>
                <h3>CRM & Marketing Automation</h3>
                <p>We implement CRM for a 360° view of the customer and automate marketing campaigns.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-4.svg" alt="POS Cloud">
                </div>
                <h3>Cloud POS Systems</h3>
                <p>Modern POS solutions for point of sale management, integrated with inventory and CRM.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-5.svg" alt="Inventory">
                </div>
                <h3>Inventory Management</h3>
                <p>Systems for centralized stock management, demand forecasting and reorder optimization.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-6.svg" alt="Analytics">
                </div>
                <h3>Retail Analytics</h3>
                <p>Business intelligence to analyze sales, customer behavior and campaign performance.</p>
            </div>
        </div>
    </div>
</section>

<IndustryRelatedProducts industrySlug="retail" lang="en" />

<!-- CTA Section -->
<section class="contact-area">
    <div class="custom-container">
        <div class="custom-row">
            <div class="contact-form-wrap" style="max-width: 100%;">
                <div class="contact-form-body" style="text-align: center;">
                    <h5 class="section-subtitle">GET STARTED TODAY</h5>
                    <h1 class="section-title">Digitalize Your Business</h1>
                    <p>Request a free consultation to discover how our IT solutions can increase sales and improve efficiency in your retail business.</p>
                    <div class="btns-group d-flex" style="justify-content: center;">
                        <a href="/en/contact/" class="theme-btn">Request Consultation</a>
                        <a href="/en/services/" class="theme-btn2">Discover Services
                            <i class="fas fa-arrow-up"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
