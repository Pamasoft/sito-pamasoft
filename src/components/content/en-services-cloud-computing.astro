---
---
<!-- Hero Section -->
<section class="hero-empowerment-area">
    <div class="custom-container">
        <div class="custom-row align-items-center">
            <div class="hero-empowerment-left-content">
                <h5 class="section-subtitle">CLOUD COMPUTING</h5>
                <h1 class="section-title fade-in">Migration & Cloud <br><span>AWS Infrastructures</span></h1>
                <p>Transform your business with our AWS cloud solutions. Secure migration, scalable architectures, cost optimization and continuous support to accelerate your digital growth.</p>
                <div class="btns-group d-flex">
                    <a href="/en/contact/" class="theme-btn">Free Consultation</a>
                    <a href="/en/services/" class="theme-btn2">Other Services
                        <i class="fas fa-arrow-up"></i>
                    </a>
                </div>
            </div>

            <div class="hero-empowerment-right-content">
                <div class="top-content">
                    <img class="desktop fade-in" src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="AWS Cloud Computing Pamasoft" width="800" height="600" fetchpriority="high" />

                    <div class="experience-box simple-shadow bounce-in">
                        <div class="experience-body d-flex align-items-center">
                            <img src="/assets/imgs/icon-years.svg" alt="AWS Partner" />
                            <div class="experience-content d-flex align-items-center">
                                <h1>AWS</h1>
                                <p>
                                    Certified
                                    <span>Partner</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Overview Section -->
<section class="about-area">
    <div class="custom-container">
        <div class="custom-row justify-content-between align-items-center">
            <div class="left-content">
                <h5 class="section-subtitle">WHY CLOUD</h5>
                <h1 class="section-title">Cloud Computing Benefits for Your Business</h1>
                <p>Cloud computing is not just a technology, it's a business strategy that allows companies to be more agile, scalable and competitive in the modern digital market.</p>
                <ul>
                    <li><i class="icon-check las la-rocket"></i> <strong>Automatic Scalability:</strong> Resources that adapt to your needs</li>
                    <li><i class="icon-check las la-chart-line"></i> <strong>Cost Reduction:</strong> Pay only for what you use, eliminate fixed costs</li>
                    <li><i class="icon-check las la-shield-alt"></i> <strong>Advanced Security:</strong> Enterprise-level protection included</li>
                    <li><i class="icon-check las la-sync"></i> <strong>Business Continuity:</strong> Automatic backups and disaster recovery</li>
                    <li><i class="icon-check las la-globe"></i> <strong>Global Access:</strong> Your data always available, anywhere</li>
                </ul>
                <a href="/en/contact/" class="theme-btn">Start Migration</a>
            </div>
            <div class="right-content">
                <img src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Cloud Computing Benefits" class="img-fluid rounded shadow" width="600" height="400" loading="lazy" decoding="async">
            </div>
        </div>
    </div>
</section>

<!-- AWS Services -->
<section class="service-area">
    <div class="custom-container">
        <div class="service-section-header section-header d-flex align-items-end justify-content-between">
            <div class="left">
                <h5 class="section-subtitle">AWS SERVICES</h5>
                <h1 class="section-title">AWS Technologies We Use</h1>
            </div>
            <p>We leverage the entire AWS ecosystem to create complete and high-performance cloud solutions</p>
        </div>
        
        <div class="services-list">
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-1.svg" alt="EC2 & ECS">
                </div>
                <h3>Compute & Container</h3>
                <p><strong>EC2, ECS, EKS, Lambda:</strong> Scalable compute infrastructures, advanced containerization and serverless computing for maximum performance.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-2.svg" alt="Storage">
                </div>
                <h3>Storage & Database</h3>
                <p><strong>S3, RDS, DynamoDB, ElastiCache:</strong> Secure storage solutions and managed databases for every type of application and workload.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-3.svg" alt="Networking">
                </div>
                <h3>Networking & Security</h3>
                <p><strong>VPC, CloudFront, WAF, IAM:</strong> Virtual private networks, global CDN and advanced security systems to protect your assets.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-4.svg" alt="DevOps">
                </div>
                <h3>DevOps & Monitoring</h3>
                <p><strong>CodePipeline, CloudWatch, X-Ray:</strong> Complete CI/CD automation and real-time monitoring for continuous and reliable deployment.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-5.svg" alt="AI Services">
                </div>
                <h3>AI & Machine Learning</h3>
                <p><strong>SageMaker, Comprehend, Rekognition:</strong> Pre-built artificial intelligence services to add AI to your applications.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-6.svg" alt="Analytics">
                </div>
                <h3>Analytics & Big Data</h3>
                <p><strong>Redshift, EMR, Kinesis, Athena:</strong> Advanced analytics platforms to transform data into strategic business insights.</p>
            </div>
        </div>
    </div>
</section>

<!-- Migration Process -->
<section class="about-area" style="background: #f8fafc;">
    <div class="custom-container">
        <div class="custom-row justify-content-between align-items-center">
            <div class="right-content">
                <img src="https://images.unsplash.com/photo-1551288049-bebda4e38f71?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Cloud Migration Process" class="img-fluid rounded shadow" width="600" height="400" loading="lazy" decoding="async">
            </div>
            <div class="left-content">
                <h5 class="section-subtitle">CLOUD MIGRATION</h5>
                <h1 class="section-title">Secure and Controlled Migration Process</h1>
                <p>Our proven methodology ensures a cloud migration without interruptions, minimizing risks and maximizing benefits for your business.</p>
                
                <div class="migration-steps">
                    <div class="step-item" style="display: flex; align-items: flex-start; margin-bottom: 1.5rem;">
                        <div style="background: var(--primary_color); color: white; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; margin-right: 1rem; flex-shrink: 0;">1</div>
                        <div>
                            <h4 style="margin-bottom: 0.5rem; color: #333;">Assessment & Planning</h4>
                            <p style="color: #666; margin-bottom: 0;">Complete analysis of existing infrastructure and definition of optimal migration strategy.</p>
                        </div>
                    </div>
                    
                    <div class="step-item" style="display: flex; align-items: flex-start; margin-bottom: 1.5rem;">
                        <div style="background: var(--primary_color); color: white; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; margin-right: 1rem; flex-shrink: 0;">2</div>
                        <div>
                            <h4 style="margin-bottom: 0.5rem; color: #333;">Design & Architecture</h4>
                            <p style="color: #666; margin-bottom: 0;">Design of cloud architecture optimized for performance, security and costs.</p>
                        </div>
                    </div>
                    
                    <div class="step-item" style="display: flex; align-items: flex-start; margin-bottom: 1.5rem;">
                        <div style="background: var(--primary_color); color: white; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; margin-right: 1rem; flex-shrink: 0;">3</div>
                        <div>
                            <h4 style="margin-bottom: 0.5rem; color: #333;">Migration & Testing</h4>
                            <p style="color: #666; margin-bottom: 0;">Gradual migration with continuous testing to ensure functionality and performance.</p>
                        </div>
                    </div>
                    
                    <div class="step-item" style="display: flex; align-items: flex-start;">
                        <div style="background: var(--primary_color); color: white; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; margin-right: 1rem; flex-shrink: 0;">4</div>
                        <div>
                            <h4 style="margin-bottom: 0.5rem; color: #333;">Optimization & Support</h4>
                            <p style="color: #666; margin-bottom: 0;">Continuous optimization and 24/7 support to maximize ROI and performance.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="contact-area">
    <div class="custom-container">
        <div class="custom-row">
            <div class="contact-form-wrap" style="max-width: 100%;">
                <div class="contact-form-body" style="text-align: center;">
                    <h5 class="section-subtitle">START TODAY</h5>
                    <h1 class="section-title">Ready for the Cloud?</h1>
                    <p>Get a free consultation and discover how AWS cloud can transform your business, reduce costs and accelerate growth.</p>
                    <div class="btns-group d-flex" style="justify-content: center;">
                        <a href="/en/contact/" class="theme-btn">Free Consultation</a>
                        <a href="/en/services/" class="theme-btn2">Other Services
                            <i class="fas fa-arrow-up"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
