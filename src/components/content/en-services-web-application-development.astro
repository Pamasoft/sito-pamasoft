---
---
<!-- Hero Section -->
<section class="hero-empowerment-area">
    <div class="custom-container">
        <div class="custom-row align-items-center">
            <div class="hero-empowerment-left-content">
                <h5 class="section-subtitle">WEB DEVELOPMENT</h5>
                <h1 class="section-title fade-in">Next Generation <br><span>Web Applications</span></h1>
                <p>We create modern, scalable and high-performance web applications with cutting-edge technologies. Spring Boot, React, PostgreSQL and cloud-native architectures for digital success.</p>
                <div class="btns-group d-flex">
                    <a href="/en/contact/" class="theme-btn">Develop Your App</a>
                    <a href="/en/services/" class="theme-btn2">Other Services
                        <i class="fas fa-arrow-up"></i>
                    </a>
                </div>
            </div>

            <div class="hero-empowerment-right-content">
                <div class="top-content">
                    <img class="desktop fade-in" src="https://images.unsplash.com/photo-1461749280684-dccba630e2f6?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Web Application Development Pamasoft" width="800" height="600" fetchpriority="high" />

                    <div class="experience-box simple-shadow bounce-in">
                        <div class="experience-body d-flex align-items-center">
                            <img src="/assets/imgs/icon-years.svg" alt="Modern Stack" />
                            <div class="experience-content d-flex align-items-center">
                                <h1>Full</h1>
                                <p>
                                    Stack
                                    <span>Modern</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modern Web Development -->
<section class="about-area">
    <div class="custom-container">
        <div class="custom-row justify-content-between align-items-center">
            <div class="left-content">
                <h5 class="section-subtitle">MODERN WEB</h5>
                <h1 class="section-title">Web Applications That Make a Difference</h1>
                <p>Not simple websites, but real business-critical applications. We develop enterprise web solutions that combine exceptional user experience, high performance and scalable architectures.</p>
                <ul>
                    <li><i class="icon-check las la-rocket"></i> <strong>Exceptional Performance:</strong> Loading <1s, advanced SEO optimization</li>
                    <li><i class="icon-check las la-mobile-alt"></i> <strong>Responsive Design:</strong> Perfect experience on every device</li>
                    <li><i class="icon-check las la-shield-alt"></i> <strong>Enterprise Security:</strong> Advanced protection and regulatory compliance</li>
                    <li><i class="icon-check las la-expand-arrows-alt"></i> <strong>Automatic Scalability:</strong> Grows with your business without limits</li>
                    <li><i class="icon-check las la-cogs"></i> <strong>Complete Integration:</strong> APIs, databases, legacy systems and cloud</li>
                </ul>
                <a href="/en/contact/" class="theme-btn">Plan Your Project</a>
            </div>
            <div class="right-content">
                <img src="https://images.unsplash.com/photo-1555066931-4365d14bab8c?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Modern Web Development" class="img-fluid rounded shadow" width="600" height="400" loading="lazy" decoding="async">
            </div>
        </div>
    </div>
</section>

<!-- Technology Stack -->
<section class="service-area">
    <div class="custom-container">
        <div class="service-section-header section-header d-flex align-items-end justify-content-between">
            <div class="left">
                <h5 class="section-subtitle">TECHNOLOGY STACK</h5>
                <h1 class="section-title">Cutting-Edge Technologies</h1>
            </div>
            <p>We use the best frameworks and technologies on the market to create robust and future-proof web applications</p>
        </div>
        
        <div class="services-list">
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-1.svg" alt="Spring Boot">
                </div>
                <h3>Spring Boot Backend</h3>
                <p><strong>Java Enterprise Platform:</strong> Robust REST APIs, microservices, advanced security, database integration and optimized performance for enterprise loads.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-2.svg" alt="React Frontend">
                </div>
                <h3>React Frontend</h3>
                <p><strong>Modern UI/UX:</strong> Reactive interfaces, reusable components, advanced state management, TypeScript for type-safe and maintainable code.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-3.svg" alt="PostgreSQL">
                </div>
                <h3>PostgreSQL Database</h3>
                <p><strong>Enterprise Database:</strong> Complex relationships, optimized performance, automatic backups, clustering for high availability and horizontal scalability.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-4.svg" alt="Microservices">
                </div>
                <h3>Microservices Architecture</h3>
                <p><strong>Modular Scalability:</strong> Independent services, separate deployments, fault tolerance, service mesh and orchestration with Kubernetes.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-5.svg" alt="DevOps">
                </div>
                <h3>DevOps & CI/CD</h3>
                <p><strong>Continuous Delivery:</strong> Automated pipelines, automatic testing, blue-green deployment, application monitoring and immediate rollback.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-6.svg" alt="Cloud Native">
                </div>
                <h3>Cloud Native</h3>
                <p><strong>Born for Cloud:</strong> Docker containers, Kubernetes orchestration, auto-scaling, service discovery and cloud-first configuration for maximum efficiency.</p>
            </div>
        </div>
    </div>
</section>

<!-- Development Process -->
<section class="about-area" style="background: #f8fafc;">
    <div class="custom-container">
        <div class="custom-row justify-content-between align-items-center">
            <div class="right-content">
                <img src="https://images.unsplash.com/photo-1551650975-87deedd944c3?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Agile Development Process" class="img-fluid rounded shadow" width="600" height="400" loading="lazy" decoding="async">
            </div>
            <div class="left-content">
                <h5 class="section-subtitle">AGILE METHODOLOGY</h5>
                <h1 class="section-title">Proven Development Process</h1>
                <p>Agile methodology with iterative sprints, continuous feedback and incremental delivery to ensure results aligned with your business needs.</p>
                
                <div class="development-process">
                    <div class="process-step" style="display: flex; align-items: flex-start; margin-bottom: 2rem;">
                        <div style="background: var(--primary_color); color: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; margin-right: 1.5rem; flex-shrink: 0;">1</div>
                        <div>
                            <h4 style="margin-bottom: 0.5rem; color: #333;">Discovery & Planning</h4>
                            <p style="color: #666; margin-bottom: 0;">Requirements analysis, user stories, technical architecture and detailed development roadmap with timeline and milestones.</p>
                        </div>
                    </div>
                    
                    <div class="process-step" style="display: flex; align-items: flex-start; margin-bottom: 2rem;">
                        <div style="background: var(--primary_color); color: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; margin-right: 1.5rem; flex-shrink: 0;">2</div>
                        <div>
                            <h4 style="margin-bottom: 0.5rem; color: #333;">Design & Prototyping</h4>
                            <p style="color: #666; margin-bottom: 0;">UI/UX design, interactive wireframes, rapid prototyping and user experience validation with stakeholders.</p>
                        </div>
                    </div>
                    
                    <div class="process-step" style="display: flex; align-items: flex-start; margin-bottom: 2rem;">
                        <div style="background: var(--primary_color); color: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; margin-right: 1.5rem; flex-shrink: 0;">3</div>
                        <div>
                            <h4 style="margin-bottom: 0.5rem; color: #333;">Agile Development</h4>
                            <p style="color: #666; margin-bottom: 0;">2-week sprints, daily standup, code review, automated testing and functional demos with continuous feedback.</p>
                        </div>
                    </div>
                    
                    <div class="process-step" style="display: flex; align-items: flex-start;">
                        <div style="background: var(--primary_color); color: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: bold; margin-right: 1.5rem; flex-shrink: 0;">4</div>
                        <div>
                            <h4 style="margin-bottom: 0.5rem; color: #333;">Launch & Support</h4>
                            <p style="color: #666; margin-bottom: 0;">Production deployment, monitoring setup, user training, complete documentation and guaranteed post-launch support.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="contact-area">
    <div class="custom-container">
        <div class="custom-row">
            <div class="contact-form-wrap" style="max-width: 100%;">
                <div class="contact-form-body" style="text-align: center;">
                    <h5 class="section-subtitle">START TODAY</h5>
                    <h1 class="section-title">Ready to Develop?</h1>
                    <p>Transform your idea into a successful web application. Free consultation to evaluate the project and define the optimal development strategy.</p>
                    <div class="btns-group d-flex" style="justify-content: center;">
                        <a href="/en/contact/" class="theme-btn">Free Consultation</a>
                        <a href="/en/services/" class="theme-btn2">Other Services
                            <i class="fas fa-arrow-up"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
