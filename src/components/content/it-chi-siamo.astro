---
---
<!-- Hero Section -->
<section class="hero-empowerment-area">
    <div class="custom-container">
        <div class="custom-row align-items-center">
            <div class="hero-empowerment-left-content">
                <h5 class="section-subtitle">LA NOSTRA STORIA</h5>
                <h1 class="section-title fade-in">25+ Anni di <br><span>Innovazione Tecnologica</span></h1>
                <p>Dal 1999 guidiamo le aziende nella trasformazione digitale, combinando esperienza consolidata e tecnologie all'avanguardia per creare soluzioni che fanno la differenza.</p>
                <div class="btns-group d-flex">
                    <a href="/servizi/" class="theme-btn">Scopri i nostri servizi</a>
                    <a href="/contatti/" class="theme-btn2">Parla con un esperto
                        <i class="fas fa-arrow-up"></i>
                    </a>
                </div>
            </div>

            <div class="hero-empowerment-right-content">
                <div class="top-content">
                    <img class="desktop fade-in" src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Team Pamasoft al lavoro" width="800" height="600" fetchpriority="high" />

                    <div class="experience-box simple-shadow bounce-in">
                        <div class="experience-body d-flex align-items-center">
                            <img src="/assets/imgs/icon-years.svg" alt="Icona Esperienza" />
                            <div class="experience-content d-flex align-items-center">
                                <h1>25+</h1>
                                <p>
                                    Anni di
                                    <span>Esperienza</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Story Section -->
<section class="about-area">
    <div class="custom-container">
        <div class="custom-row justify-content-between align-items-center">
            <div class="left-content">
                <img src="https://images.unsplash.com/photo-1485827404703-89b55fcc595e?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Innovazione Tecnologica" class="img-fluid rounded shadow" width="600" height="400" loading="lazy" decoding="async">
            </div>
            <div class="right-content">
                <h5 class="section-subtitle">LA NOSTRA STORIA</h5>
                <h1 class="section-title">Dal 1999, Innovazione Continua</h1>
                <p>Fondata nel 1999, Pamasoft è nata dalla visione di un gruppo di sviluppatori appassionati che credevano nel potere della tecnologia per trasformare il business.</p>
                <p>Nel corso degli anni, abbiamo assistito e guidato l'evoluzione tecnologica, dai primi sistemi client-server all'era del cloud computing, dall'emergere del web alle moderne architetture a microservizi.</p>
            </div>
        </div>
    </div>
</section>

<!-- Team & Expertise Section -->
<section class="service-area">
    <div class="custom-container">
        <div class="service-section-header section-header d-flex align-items-end justify-content-between">
            <div class="left">
                <h5 class="section-subtitle">IL NOSTRO TEAM</h5>
                <h1 class="section-title">Esperti in Tecnologie All'Avanguardia</h1>
            </div>
            <p>Un team di professionisti altamente qualificati con competenze specializzate in ogni area tecnologica</p>
        </div>
        
        <div class="services-list d-flex">
                <div class="service-card">
                    <div class="service-icon">
                        <img src="/assets/imgs/service-icon-1.svg" alt="Cloud Computing">
                    </div>
                    <h3>Cloud Computing</h3>
                    <p>Esperti certificati AWS con oltre 10 anni di esperienza in architetture cloud scalabili e sicure.</p>
                </div>
                
                <div class="service-card">
                    <div class="service-icon">
                        <img src="/assets/imgs/service-icon-2.svg" alt="Intelligenza Artificiale">
                    </div>
                    <h3>Intelligenza Artificiale</h3>
                    <p>Specialisti in Machine Learning e AI generativa per soluzioni innovative e competitive.</p>
                </div>
                
                <div class="service-card">
                    <div class="service-icon">
                        <img src="/assets/imgs/service-icon-3.svg" alt="Cybersecurity">
                    </div>
                    <h3>Cybersecurity</h3>
                    <p>Team di sicurezza informatica con certificazioni internazionali per proteggere i tuoi asset digitali.</p>
                </div>
                
                <div class="service-card">
                    <div class="service-icon">
                        <img src="/assets/imgs/service-icon-4.svg" alt="Blockchain">
                    </div>
                    <h3>Blockchain</h3>
                    <p>Sviluppatori blockchain esperti in smart contracts e soluzioni decentralizzate innovative.</p>
                </div>
                
                <div class="service-card">
                    <div class="service-icon">
                        <img src="/assets/imgs/service-icon-5.svg" alt="Web Development">
                    </div>
                    <h3>Sviluppo Web</h3>
                    <p>Full-stack developers specializzati in tecnologie moderne come React, Spring Boot e PostgreSQL.</p>
                </div>
                
                <div class="service-card">
                    <div class="service-icon">
                        <img src="/assets/imgs/service-icon-6.svg" alt="Integration">
                    </div>
                    <h3>Integrazioni</h3>
                    <p>Architetti di sistemi esperti in microservizi e integrazioni complesse tra piattaforme diverse.</p>
                </div>
        </div>
    </div>
</section>

<!-- Mission Section -->
<section class="about-area">
    <div class="custom-container">
        <div class="custom-row justify-content-between align-items-center">
            <div class="left-content">
                <h5 class="section-subtitle">LA NOSTRA MISSIONE</h5>
                <h1 class="section-title">Guidare la Trasformazione Digitale del Futuro</h1>
                <p>La nostra missione è semplice ma ambiziosa: aiutare le aziende a sfruttare appieno il potenziale della tecnologia per crescere, innovare e competere nel mercato globale.</p>
                <ul>
                    <li>
                        <i class="icon-check las la-rocket"></i> Accelerare l'Innovazione
                    </li>
                    <li>
                        <i class="icon-check las la-chart-line"></i> Aumentare la Competitività
                    </li>
                    <li>
                        <i class="icon-check las la-shield-alt"></i> Garantire la Sicurezza
                    </li>
                </ul>
                <a href="/servizi/" class="theme-btn">Scopri i nostri servizi</a>
            </div>
            <div class="right-content">
                <img src="https://images.unsplash.com/photo-1552664730-d307ca884978?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Trasformazione Digitale" class="img-fluid rounded shadow" width="600" height="400" loading="lazy" decoding="async">
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="contact-area">
    <div class="custom-container">
        <div class="custom-row">
            <div class="contact-experience">
                <ul>
                    <li>
                        <h1>25+ <span>Anni</span></h1>
                        <p>Esperienza nel Settore</p>
                    </li>
                    <li>
                        <h1>500+ <span>Progetti</span></h1>
                        <p>Realizzati con Successo</p>
                    </li>
                    <li>
                        <h1>Full <span>Stack</span></h1>
                        <p>Delivery</p>
                    </li>
                    <li>
                        <h1>Team <span>Dedicato</span></h1>
                        <p>Sempre Disponibile</p>
                    </li>
                </ul>
            </div>
            
            <div class="contact-form-wrap">
                <div class="contact-form-body">
                    <h5 class="section-subtitle">INIZIA OGGI</h5>
                    <h1 class="section-title">Pronto a Trasformare il Tuo Business?</h1>
                    <p>Scopri come Pamasoft può aiutarti a raggiungere i tuoi obiettivi tecnologici con oltre 25 anni di esperienza.</p>
                    <div class="btns-group d-flex">
                        <a href="/contatti/" class="theme-btn">Contattaci Oggi</a>
                        <a href="/servizi/" class="theme-btn2">Scopri i Servizi
                            <i class="fas fa-arrow-up"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
