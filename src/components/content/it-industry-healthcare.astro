---
import IndustryRelatedProducts from '../IndustryRelatedProducts.astro';
---
<!-- Hero Section -->
<section class="hero-empowerment-area">
    <div class="custom-container">
        <div class="custom-row align-items-center">
            <div class="hero-empowerment-left-content">
                <h5 class="section-subtitle">HEALTHCARE</h5>
                <h1 class="section-title fade-in">Soluzioni IT per la <br><span>Sanità Digitale</span></h1>
                <p>Trasformiamo il settore sanitario con tecnologie innovative: cartelle cliniche elettroniche, telemedicina, AI per la diagnostica e sistemi di gestione ospedaliera. Conformità GDPR garantita.</p>
                <div class="btns-group d-flex">
                    <a href="/contatti/" class="theme-btn">Richiedi Consulenza</a>
                    <a href="/industry/" class="theme-btn2">Altri Settori
                        <i class="fas fa-arrow-up"></i>
                    </a>
                </div>
            </div>

            <div class="hero-empowerment-right-content">
                <div class="top-content">
                    <img class="desktop fade-in" src="https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Healthcare IT Solutions" width="800" height="600" fetchpriority="high" />

                    <div class="experience-box simple-shadow bounce-in">
                        <div class="experience-body d-flex align-items-center">
                            <img src="/assets/imgs/icon-years.svg" alt="Healthcare" />
                            <div class="experience-content d-flex align-items-center">
                                <h1>100+</h1>
                                <p>
                                    Strutture
                                    <span>Sanitarie</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Overview Section -->
<section class="about-area">
    <div class="custom-container">
        <div class="custom-row justify-content-between align-items-center">
            <div class="left-content">
                <h5 class="section-subtitle">TRASFORMAZIONE DIGITALE</h5>
                <h1 class="section-title">Innovazione per il Settore Sanitario</h1>
                <p>Le nostre soluzioni IT aiutano ospedali, cliniche e studi medici a migliorare l'efficienza operativa, la qualità delle cure e l'esperienza del paziente attraverso la digitalizzazione.</p>
                <ul>
                    <li><i class="icon-check las la-check"></i> <strong>Cartelle Cliniche Elettroniche:</strong> Gestione digitale completa dei dati sanitari</li>
                    <li><i class="icon-check las la-check"></i> <strong>Telemedicina:</strong> Piattaforme per consulti e monitoraggio remoto</li>
                    <li><i class="icon-check las la-check"></i> <strong>AI Diagnostica:</strong> Intelligenza artificiale per supporto decisionale</li>
                    <li><i class="icon-check las la-check"></i> <strong>Conformità GDPR:</strong> Sicurezza e privacy dei dati sanitari</li>
                    <li><i class="icon-check las la-check"></i> <strong>Integrazione Sistemi:</strong> Interoperabilità con sistemi esistenti</li>
                </ul>
                <a href="/contatti/" class="theme-btn">Scopri le Soluzioni</a>
            </div>
            <div class="right-content">
                <img src="https://images.unsplash.com/photo-1631815588090-d4bfec5b1ccb?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Digital Healthcare" class="img-fluid rounded shadow" width="600" height="400" loading="lazy" decoding="async">
            </div>
        </div>
    </div>
</section>

<!-- Solutions -->
<section class="service-area">
    <div class="custom-container">
        <div class="service-section-header section-header d-flex align-items-end justify-content-between">
            <div class="left">
                <h5 class="section-subtitle">SOLUZIONI</h5>
                <h1 class="section-title">Le Nostre Soluzioni per Healthcare</h1>
            </div>
            <p>Tecnologie all'avanguardia per modernizzare il settore sanitario</p>
        </div>
        
        <div class="services-list">
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-1.svg" alt="EMR/EHR">
                </div>
                <h3>Cartelle Cliniche Elettroniche</h3>
                <p>Sistemi EMR/EHR completi per la gestione digitale delle cartelle cliniche, prescrizioni elettroniche e storico paziente.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-2.svg" alt="Telemedicina">
                </div>
                <h3>Piattaforme Telemedicina</h3>
                <p>Soluzioni per teleconsulti, monitoraggio remoto pazienti e gestione appuntamenti virtuali con integrazione video.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-3.svg" alt="AI Diagnostica">
                </div>
                <h3>AI per Diagnostica</h3>
                <p>Intelligenza artificiale per analisi imaging medicale, supporto decisionale clinico e predizione rischi sanitari.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-4.svg" alt="PACS">
                </div>
                <h3>Sistemi PACS/RIS</h3>
                <p>Gestione e archiviazione immagini medicali con sistemi PACS e RIS integrati per radiologia e diagnostica.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-5.svg" alt="Sicurezza">
                </div>
                <h3>Sicurezza e Conformità</h3>
                <p>Protezione dati sanitari conforme GDPR, crittografia end-to-end e audit trail completi per compliance normativa.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-6.svg" alt="Analytics">
                </div>
                <h3>Healthcare Analytics</h3>
                <p>Business intelligence e analytics per ottimizzazione operativa, analisi costi e miglioramento qualità cure.</p>
            </div>
        </div>
    </div>
</section>

<IndustryRelatedProducts industrySlug="healthcare" lang="it" />

<!-- CTA Section -->
<section class="contact-area">
    <div class="custom-container">
        <div class="custom-row">
            <div class="contact-form-wrap" style="max-width: 100%;">
                <div class="contact-form-body" style="text-align: center;">
                    <h5 class="section-subtitle">INIZIA OGGI</h5>
                    <h1 class="section-title">Digitalizziamo la Tua Struttura Sanitaria</h1>
                    <p>Richiedi una consulenza gratuita per scoprire come le nostre soluzioni IT possono migliorare l'efficienza e la qualità delle cure nella tua struttura.</p>
                    <div class="btns-group d-flex" style="justify-content: center;">
                        <a href="/contatti/" class="theme-btn">Richiedi Consulenza</a>
                        <a href="/servizi/" class="theme-btn2">Scopri i Servizi
                            <i class="fas fa-arrow-up"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
