---
---
<!-- Hero Section -->
<section class="hero-empowerment-area">
    <div class="custom-container">
        <div class="custom-row align-items-center">
            <div class="hero-empowerment-left-content">
                <h5 class="section-subtitle">MANUFACTURING</h5>
                <h1 class="section-title fade-in">IT Solutions for Industry 4.0</h1>
                <p>We support the digital transformation of the manufacturing sector with Smart Factory solutions: industrial IoT, MES for production control, predictive maintenance and digital twin.</p>
                <div class="btns-group d-flex">
                    <a href="/en/contact/" class="theme-btn">Request Consultation</a>
                    <a href="/en/industry/" class="theme-btn2">Other Industries
                        <i class="fas fa-arrow-up"></i>
                    </a>
                </div>
            </div>

            <div class="hero-empowerment-right-content">
                <div class="top-content">
                    <img class="desktop fade-in" src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Manufacturing IT Solutions" width="800" height="600" fetchpriority="high" />

                    <div class="experience-box simple-shadow bounce-in">
                        <div class="experience-body d-flex align-items-center">
                            <img src="/assets/imgs/icon-years.svg" alt="Manufacturing" />
                            <div class="experience-content d-flex align-items-center">
                                <h1>40+</h1>
                                <p>
                                    Digitalized
                                    <span>Facilities</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Overview Section -->
<section class="about-area">
    <div class="custom-container">
        <div class="custom-row justify-content-between align-items-center">
            <div class="left-content">
                <h5 class="section-subtitle">SMART FACTORY</h5>
                <h1 class="section-title">Production Digitalization</h1>
                <p>Our Industry 4.0 solutions help manufacturing companies optimize processes, reduce costs, improve quality and increase production flexibility.</p>
                <ul>
                    <li><i class="icon-check las la-check"></i> <strong>Industrial IoT:</strong> Machine connectivity and monitoring</li>
                    <li><i class="icon-check las la-check"></i> <strong>MES Systems:</strong> Production control and management</li>
                    <li><i class="icon-check las la-check"></i> <strong>Predictive Maintenance:</strong> Reduced machine downtime</li>
                    <li><i class="icon-check las la-check"></i> <strong>Digital Twin:</strong> Process simulation and optimization</li>
                    <li><i class="icon-check las la-check"></i> <strong>ERP Integration:</strong> Connection between production and management</li>
                </ul>
                <a href="/en/contact/" class="theme-btn">Discover Solutions</a>
            </div>
            <div class="right-content">
                <img src="https://images.unsplash.com/photo-1567789884554-0b844b597180?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Smart Factory" class="img-fluid rounded shadow" width="600" height="400" loading="lazy" decoding="async">
            </div>
        </div>
    </div>
</section>

<!-- Solutions -->
<section class="service-area">
    <div class="custom-container">
        <div class="service-section-header section-header d-flex align-items-end justify-content-between">
            <div class="left">
                <h5 class="section-subtitle">SOLUTIONS</h5>
                <h1 class="section-title">Our Manufacturing Solutions</h1>
            </div>
            <p>Cutting-edge technologies for the smart factory</p>
        </div>
        
        <div class="services-list">
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-1.svg" alt="IoT">
                </div>
                <h3>Industrial IoT & Connectivity</h3>
                <p>We connect machines and sensors to collect real-time data and monitor performance.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-2.svg" alt="MES">
                </div>
                <h3>MES Systems</h3>
                <p>We implement MES for production scheduling, control and traceability.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-3.svg" alt="AI">
                </div>
                <h3>Predictive Maintenance</h3>
                <p>We use AI to predict failures, reduce machine downtime and optimize maintenance.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-4.svg" alt="Digital Twin">
                </div>
                <h3>Digital Twin</h3>
                <p>We create digital replicas of processes and plants for simulations and optimizations.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-5.svg" alt="QMS">
                </div>
                <h3>Quality Management</h3>
                <p>Systems for in-process quality control, non-conformity management and traceability.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-6.svg" alt="Analytics">
                </div>
                <h3>Manufacturing Analytics</h3>
                <p>Dashboards and KPIs (OEE, MTTR) to monitor and improve production efficiency.</p>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="contact-area">
    <div class="custom-container">
        <div class="custom-row">
            <div class="contact-form-wrap" style="max-width: 100%;">
                <div class="contact-form-body" style="text-align: center;">
                    <h5 class="section-subtitle">GET STARTED TODAY</h5>
                    <h1 class="section-title">Create Your Smart Factory</h1>
                    <p>Request a free consultation to discover how our Industry 4.0 solutions can make your production more efficient and competitive.</p>
                    <div class="btns-group d-flex" style="justify-content: center;">
                        <a href="/en/contact/" class="theme-btn">Request Consultation</a>
                        <a href="/en/services/" class="theme-btn2">Discover Services
                            <i class="fas fa-arrow-up"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
