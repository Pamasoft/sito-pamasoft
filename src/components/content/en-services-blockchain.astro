---
---
<!-- Hero Section -->
<section class="hero-empowerment-area">
    <div class="custom-container">
        <div class="custom-row align-items-center">
            <div class="hero-empowerment-left-content">
                <h5 class="section-subtitle">BLOCKCHAIN & WEB3</h5>
                <h1 class="section-title fade-in">The Decentralized Future <br><span>is Already Here</span></h1>
                <p>Enter the Web3 era with innovative blockchain solutions. Smart contracts, DeFi, NFT and decentralized applications to revolutionize your business model.</p>
                <div class="btns-group d-flex">
                    <a href="/en/contact/" class="theme-btn">Web3 Consultation</a>
                    <a href="/en/services/" class="theme-btn2">Other Services
                        <i class="fas fa-arrow-up"></i>
                    </a>
                </div>
            </div>

            <div class="hero-empowerment-right-content">
                <div class="top-content">
                    <img class="desktop fade-in" src="https://images.unsplash.com/photo-1639762681485-074b7f938ba0?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Blockchain Web3 Pamasoft" width="800" height="600" fetchpriority="high" />

                    <div class="experience-box simple-shadow bounce-in">
                        <div class="experience-body d-flex align-items-center">
                            <img src="/assets/imgs/icon-years.svg" alt="Web3 Solutions" />
                            <div class="experience-content d-flex align-items-center">
                                <h1>Web3</h1>
                                <p>
                                    Future
                                    <span>Ready</span>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Blockchain Revolution -->
<section class="about-area">
    <div class="custom-container">
        <div class="custom-row justify-content-between align-items-center">
            <div class="left-content">
                <h5 class="section-subtitle">BLOCKCHAIN REVOLUTION</h5>
                <h1 class="section-title">Transparency, Security, Decentralization</h1>
                <p>Blockchain is not just cryptocurrencies: it's a revolutionary technology that eliminates intermediaries, guarantees total transparency and creates new business models based on distributed trust.</p>
                <ul>
                    <li><i class="icon-check las la-shield-alt"></i> <strong>Cryptographic Security:</strong> Immutability and guaranteed data protection</li>
                    <li><i class="icon-check las la-eye"></i> <strong>Total Transparency:</strong> Every transaction is verifiable and traceable</li>
                    <li><i class="icon-check las la-handshake"></i> <strong>Trust-less:</strong> Automatic trust without intermediaries</li>
                    <li><i class="icon-check las la-globe"></i> <strong>Decentralization:</strong> Distributed control and resilience</li>
                    <li><i class="icon-check las la-coins"></i> <strong>New Revenue Models:</strong> Tokenization and innovative monetization</li>
                </ul>
                <a href="/en/contact/" class="theme-btn">Explore Opportunities</a>
            </div>
            <div class="right-content">
                <img src="https://images.unsplash.com/photo-1559526324-4b87b5e36e44?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Blockchain Technology" class="img-fluid rounded shadow" width="600" height="400" loading="lazy" decoding="async">
            </div>
        </div>
    </div>
</section>

<!-- Blockchain Services -->
<section class="service-area">
    <div class="custom-container">
        <div class="service-section-header section-header d-flex align-items-end justify-content-between">
            <div class="left">
                <h5 class="section-subtitle">BLOCKCHAIN SERVICES</h5>
                <h1 class="section-title">Complete Web3 Solutions</h1>
            </div>
            <p>From strategic consulting to development, we cover every aspect of the blockchain ecosystem</p>
        </div>
        
        <div class="services-list">
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-1.svg" alt="Smart Contracts">
                </div>
                <h3>Smart Contracts</h3>
                <p><strong>Self-Executing Contracts:</strong> Smart contract development on Ethereum, Polygon, Binance Smart Chain for business logic automation and payments.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-2.svg" alt="DeFi Solutions">
                </div>
                <h3>DeFi Applications</h3>
                <p><strong>Decentralized Finance:</strong> DeFi protocols, yield farming, liquidity pools, lending platforms and decentralized exchanges (DEX).</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-3.svg" alt="NFT Marketplace">
                </div>
                <h3>NFT & Marketplace</h3>
                <p><strong>Unique Digital Assets:</strong> NFT creation, customized marketplaces, real asset tokenization and automatic royalty systems.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-4.svg" alt="dApps">
                </div>
                <h3>dApps Development</h3>
                <p><strong>Decentralized Applications:</strong> Web3 frontend, wallet integration, blockchain interaction and optimized user experience for dApps.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-5.svg" alt="Tokenization">
                </div>
                <h3>Asset Tokenization</h3>
                <p><strong>Advanced Tokenization:</strong> Real estate, art, commodities, equity tokenization with regulatory compliance and decentralized governance.</p>
            </div>
            
            <div class="service-card">
                <div class="service-icon">
                    <img src="/assets/imgs/service-icon-6.svg" alt="Blockchain Consulting">
                </div>
                <h3>Blockchain Strategy</h3>
                <p><strong>Strategic Consulting:</strong> Blockchain assessment, implementation roadmap, tokenomics design and regulatory compliance for Web3 projects.</p>
            </div>
        </div>
    </div>
</section>

<!-- Technology Stack -->
<section class="about-area" style="background: #f8fafc;">
    <div class="custom-container">
        <div class="custom-row justify-content-between align-items-center">
            <div class="right-content">
                <img src="https://images.unsplash.com/photo-1621761191319-c6fb62004040?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" alt="Blockchain Development Stack" class="img-fluid rounded shadow" width="600" height="400" loading="lazy" decoding="async">
            </div>
            <div class="left-content">
                <h5 class="section-subtitle">BLOCKCHAIN TECHNOLOGIES</h5>
                <h1 class="section-title">Advanced Multi-Chain Stack</h1>
                <p>We work with the main blockchains and use the most advanced development tools to ensure high-performance and secure solutions.</p>
                
                <div class="tech-stack">
                    <div class="tech-item" style="margin-bottom: 1.5rem;">
                        <h4 style="color: var(--primary_color); margin-bottom: 0.5rem;"><i class="fab fa-ethereum" style="margin-right: 0.5rem;"></i>Blockchain Networks</h4>
                        <p style="color: #666;"><strong>Ethereum, Polygon, Binance Smart Chain, Avalanche, Solana</strong></p>
                    </div>
                    
                    <div class="tech-item" style="margin-bottom: 1.5rem;">
                        <h4 style="color: var(--primary_color); margin-bottom: 0.5rem;"><i class="fas fa-code" style="margin-right: 0.5rem;"></i>Development Tools</h4>
                        <p style="color: #666;"><strong>Solidity, Rust, Hardhat, Truffle, Web3.js, Ethers.js</strong></p>
                    </div>
                    
                    <div class="tech-item" style="margin-bottom: 1.5rem;">
                        <h4 style="color: var(--primary_color); margin-bottom: 0.5rem;"><i class="fas fa-wallet" style="margin-right: 0.5rem;"></i>Web3 Integration</h4>
                        <p style="color: #666;"><strong>MetaMask, WalletConnect, Rainbow Kit, Moralis, Alchemy</strong></p>
                    </div>
                    
                    <div class="tech-item">
                        <h4 style="color: var(--primary_color); margin-bottom: 0.5rem;"><i class="fas fa-database" style="margin-right: 0.5rem;"></i>Infrastructure</h4>
                        <p style="color: #666;"><strong>IPFS, The Graph, Chainlink Oracles, OpenZeppelin</strong></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA Section -->
<section class="contact-area">
    <div class="custom-container">
        <div class="custom-row">
            <div class="contact-form-wrap" style="max-width: 100%;">
                <div class="contact-form-body" style="text-align: center;">
                    <h5 class="section-subtitle">ENTER WEB3</h5>
                    <h1 class="section-title">Ready for the Future?</h1>
                    <p>Discover how blockchain can revolutionize your business model. Free consultation to explore Web3 opportunities in your industry.</p>
                    <div class="btns-group d-flex" style="justify-content: center;">
                        <a href="/en/contact/" class="theme-btn">Web3 Consultation</a>
                        <a href="/en/services/" class="theme-btn2">Other Services
                            <i class="fas fa-arrow-up"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
