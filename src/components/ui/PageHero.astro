---
interface Crumb { name: string; href?: string }
interface Props { crumbs: Crumb[]; title: string; lead: string }
const { crumbs, title, lead } = Astro.props;
---
<section class="hero">
  <div class="wrap">
    <nav class="crumb" aria-label="Breadcrumb">
      {crumbs.map((c, i) => (<>{i > 0 && ' · '}{c.href ? <a href={c.href}>{c.name}</a> : <span aria-current="page">{c.name}</span>}</>))}
    </nav>
    <h1 style="max-width:20ch;font-size:clamp(34px,4.4vw,54px)">{title}</h1>
    <p class="lead" style="margin-top:18px">{lead}</p>
    <slot />
  </div>
</section>
