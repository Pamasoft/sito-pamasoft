---
import type { Locale } from '../config/site';
import { getAlternateUrl } from '../i18n/utils';
import { UI } from '../data/ui';
import { PRODUCTS, MENU_GROUPS, productById } from '../data/products';
import { SERVICES } from '../data/services';
import { INDUSTRIES } from '../data/industries';
import { CALENDLY, url, productUrl, serviceUrl, industryUrl } from '../data/routes';
import { dot } from '../lib/screens';

interface Props {
  lang?: Locale;
  path: string;
  current?: string;
}

const { lang = 'it', path, current } = Astro.props;
const t = UI[lang];
const other = lang === 'it' ? 'en' : 'it';
const altHref = getAlternateUrl(path, other);
const firstSentence = (s: string) => `${s.split('. ')[0].replace(/\.$/, '')}.`;
const chevron = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>';
---

<header>
  <div class="wrap nav">
    <a class="logo" href={url(lang, 'home')} aria-label={lang === 'en' ? 'Pamasoft, home page' : 'Pamasoft, home'}>
      <span class="logo-crop"><img src="/assets/images/logo-blu.png" alt="Pamasoft" width="250" height="150" /></span>
    </a>
    <nav aria-label={t.mainMenu}>
      <ul class="menu">
        <li>
          <button type="button" aria-expanded="false" aria-controls="dd-products" data-dd class:list={[{ on: current === 'products' }]}>
            {t.nav.products} <Fragment set:html={chevron} />
          </button>
          <div class="drop mega" id="dd-products" hidden>
            {
              MENU_GROUPS[lang].map(([g, ids]) => (
                <div>
                  <h4>{g}</h4>
                  {ids.map((id) => {
                    const p = productById(id);
                    return (
                      <a class="mi" href={productUrl(lang, p.slug)}>
                        <Fragment set:html={dot(p.color, p.abbr)} />
                        <span>
                          <b>{p.name}</b>
                          <small>{p[lang].cat}</small>
                        </span>
                      </a>
                    );
                  })}
                </div>
              ))
            }
            <div class="all">
              <span>{t.megaAll[0]}</span>
              <a href={url(lang, 'products')}>{t.megaAll[1]}</a>
            </div>
          </div>
        </li>
        <li>
          <button type="button" aria-expanded="false" aria-controls="dd-services" data-dd class:list={[{ on: current === 'services' }]}>
            {t.nav.services} <Fragment set:html={chevron} />
          </button>
          <div class="drop list" id="dd-services" hidden>
            {
              SERVICES.map((s) => (
                <a href={serviceUrl(lang, s.key)}>
                  {s[lang].n}
                  <small>{firstSentence(s[lang].l)}</small>
                </a>
              ))
            }
            <a href={url(lang, 'services')} class="dd-all">{t.allServices}</a>
          </div>
        </li>
        <li>
          <button type="button" aria-expanded="false" aria-controls="dd-industry" data-dd class:list={[{ on: current === 'industry' }]}>
            {t.nav.industry} <Fragment set:html={chevron} />
          </button>
          <div class="drop list" id="dd-industry" hidden>
            {INDUSTRIES.map((s) => <a href={industryUrl(lang, s.key)}>{s[lang].n}</a>)}
            <a href={url(lang, 'industry')} class="dd-all">{t.allIndustries}</a>
          </div>
        </li>
        <li><a href={url(lang, 'about')} class:list={[{ on: current === 'about' }]} aria-current={current === 'about' ? 'page' : undefined}>{t.nav.about}</a></li>
        {/* Blog nascosto dal menu (route mantenute): <li><a href={url(lang, 'blog')}>{t.nav.blog}</a></li> */}
        <li><a href={url(lang, 'contact')} class:list={[{ on: current === 'contact' }]} aria-current={current === 'contact' ? 'page' : undefined}>{t.nav.contact}</a></li>
      </ul>
    </nav>
    <div class="acts">
      <a class="lang" href={altHref} hreflang={other} lang={other} aria-label={t.langSwitch.aria}>{t.langSwitch.short}</a>
      <a class="btn btn-p" href={url(lang, 'contact')}>{t.contactUs}</a>
    </div>
    <button class="burger" id="burger" type="button" aria-label={t.openMenu} aria-expanded="false" aria-controls="mob" data-open={t.openMenu} data-close={t.closeMenu}><span></span></button>
  </div>
</header>

<nav class="mob" id="mob" aria-label={t.mobileMenu}>
  <details>
    <summary>{t.nav.products}</summary>
    <div class="sub">
      {
        PRODUCTS.map((p) => (
          <a href={productUrl(lang, p.slug)}>
            <Fragment set:html={dot(p.color, p.abbr)} />
            <span>
              <b>{p.name}</b>
              <small>{p[lang].cat}</small>
            </span>
          </a>
        ))
      }
      <a href={url(lang, 'products')} class="one"><b>{t.megaAll[1]}</b></a>
    </div>
  </details>
  <details>
    <summary>{t.nav.services}</summary>
    <div class="sub">
      {SERVICES.map((s) => <a href={serviceUrl(lang, s.key)} class="one"><b>{s[lang].n}</b></a>)}
      <a href={url(lang, 'services')} class="one"><b>{t.allServices}</b></a>
    </div>
  </details>
  <details>
    <summary>{t.nav.industry}</summary>
    <div class="sub">
      {INDUSTRIES.map((s) => <a href={industryUrl(lang, s.key)} class="one"><b>{s[lang].n}</b></a>)}
      <a href={url(lang, 'industry')} class="one"><b>{t.allIndustries}</b></a>
    </div>
  </details>
  <a href={url(lang, 'about')}>{t.nav.about}</a>
  {/* Blog nascosto dal menu mobile: <a href={url(lang, 'blog')}>{t.nav.blog}</a> */}
  <a href={url(lang, 'contact')}>{t.nav.contact}</a>
  <a href={altHref} hreflang={other} lang={other}>{t.langSwitch.label}</a>
  <div class="mbtn">
    <a class="btn btn-p" href={url(lang, 'contact')}>{t.contactUs}</a>
    <a class="btn btn-g" href={CALENDLY}>{t.bookCall}</a>
  </div>
</nav>
