---
import type { Locale } from '../config/site';
import { UI } from '../data/ui';
import { productById } from '../data/products';
import { SERVICES, SERVICE_FOOTER } from '../data/services';
import { EMAIL, LINKEDIN, url, productUrl, serviceUrl } from '../data/routes';

interface Props {
  lang?: Locale;
}

const { lang = 'it' } = Astro.props;
const t = UI[lang];
const f = t.footer;
const year = new Date().getFullYear();
const featured = ['cloudstay', 'cloudpos', 'cloudsuite', 'posway'].map(productById);
---

<footer>
  <div class="wrap foot">
    <div>
      <span class="logo-crop"><img src="/assets/images/logo-bianco.png" alt="Pamasoft" width="250" height="150" loading="lazy" /></span>
      <p style="margin-top:14px;max-width:34ch">{f.tagline}</p>
    </div>
    <div>
      <h4>{f.products}</h4>
      {featured.map((p) => <a href={productUrl(lang, p.slug)}>{p.name}</a>)}
      <a href={url(lang, 'products')}>{f.allProducts}</a>
    </div>
    <div>
      <h4>{f.services}</h4>
      {SERVICES.map((s) => <a href={serviceUrl(lang, s.key)}>{SERVICE_FOOTER[lang][s.key]}</a>)}
    </div>
    <div>
      <h4>{f.company}</h4>
      <a href={url(lang, 'about')}>{t.nav.about}</a>
      <a href={url(lang, 'industry')}>{t.nav.industry}</a>
      {/* Blog nascosto dal footer (route mantenute): <a href={url(lang, 'blog')}>{t.nav.blog}</a> */}
      <a href={url(lang, 'contact')}>{t.nav.contact}</a>
    </div>
    <div>
      <h4>{f.contacts}</h4>
      <a href={`mailto:${EMAIL}`}>{EMAIL}</a>
      <a href={LINKEDIN} target="_blank" rel="noopener">LinkedIn</a>
    </div>
  </div>
  <div class="wrap legal">
    © {year} Pamasoft · {f.legal} ·
    <a href={url(lang, 'privacy')} style="display:inline">{f.privacy}</a> ·
    <a href={url(lang, 'cookie')} style="display:inline">{f.cookie}</a> ·
    <a href={url(lang, 'terms')} style="display:inline">{f.terms}</a>
  </div>
</footer>
